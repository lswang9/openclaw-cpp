wedOrigins is omitted. HTTP is allowed only for localhost, 127.0.0.1, or [::1]. Per-requester MCP OAuth uses it to build the callback URL at /oauth/mcp/callback; channel session links and plugin-generated viewer links use it to reach the Control UI and Gateway routes."},"portals":{"type":"object","properties":{"ingress":{"type":"object","properties":{"domain":{"type":"string","title":"Portal Wildcard Domain","description":"Bare DNS domain for random portal subdomains (for example previews.example.net). Configure wildcard DNS and HTTPS privately; do not share the Gateway or Control UI hostname namespace."},"port":{"type":"integer","minimum":1,"maximum":65535,"title":"Portal Ingress Loopback Port","description":"Dedicated loopback HTTP port receiving the private wildcard HTTPS proxy. Must differ from the Gateway port. This is the backend port, not the public HTTPS port."}},"required":["domain","port"],"additionalProperties":false,"title":"Private Portal Ingress","description":"Optional operator-managed private HTTPS wildcard reverse proxy. Forward original Host, paths, and WebSocket upgrades to the dedicated loopback listener. Portal bearer authentication remains required. Requires Gateway restart."}},"additionalProperties":false,"title":"Gateway Portals","description":"Portal publication and private ingress settings."},"github":{"type":"object","properties":{"host":{"type":"string","minLength":1},"apiBaseUrl":{"type":"string","format":"uri"}},"additionalProperties":false},"projects":{"type":"object","properties":{"defaultRepository":{"type":"object","properties":{"url":{"type":"string","minLength":1},"ref":{"type":"string","minLength":1,"maxLength":255}},"required":["url"],"additionalProperties":false},"nativeGitHubSearch":{"type":"boolean"}},"additionalProperties":false},"controlUi":{"type":"object","properties":{"dangerouslyDisableDeviceAuth":{"type":"boolean"},"enabled":{"type":"boolean","title":"Control UI Enabled","description":"Enables serving the gateway Control UI from the gateway HTTP process when true. Keep enabled for local administration, and disable when an external control surface replaces it."},"basePath":{"type":"string","title":"Control UI Base Path","description":"Optional URL prefix where the Control UI is served (e.g. /openclaw)."},"experimental":{"type":"object","properties":{"customPlugins":{"type":"boolean","title":"Custom Plugin UI","description":"Allow user-installed plugins to execute native JavaScript in the Control UI (default: false). Bundled plugin views remain available. Custom UI shares the signed-in operator's Gateway permissions; enable only for trusted plugins. Changes apply without a Gateway restart. Reload open Control UI pages to clear previously loaded plugin code."}},"additionalProperties":false,"title":"Experimental Control UI Features","description":"Opt-in Control UI experiments. These capabilities may change between releases and remain disabled unless explicitly enabled."},"root":{"type":"string","title":"Control UI Assets Root","description":"Optional filesystem root for Control UI assets (defaults to dist/control-ui)."},"environment":{"type":"object","properties":{"label":{"type":"string","minLength":1,"maxLength":24,"title":"Control UI Environment Label","description":"Environment label displayed in the Control UI and browser tab; surrounding whitespace is trimmed and the label must contain 1 to 24 characters."},"color":{"type":"string","enum":["teal","amber","purple","coral","pink","blue","green","red","gray"],"title":"Control UI Environment Color","description":"Named environment color ramp: teal, amber, purple, coral, pink, blue, green, red, or gray."}},"required":["label","color"],"additionalProperties":false,"title":"Control UI Environment","description":"Optional public environment identity shown in the Control UI stripe, agent avatar, label pills, browser title, and favicon. Omit it to preserve the default appearance."},"communityInvite":{"type":"boolean","title":"Control UI